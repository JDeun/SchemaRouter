  "score_semantics": {
    "absolute_score_thresholds_allowed": false,
    "rationale": "CapabilityCandidate.score is a deterministic ranking score, not a calibrated probability shared across retrieval backends or catalogs.",
    "adaptive_signal": "positive-affine-invariant adjacent score gap normalized by the already-ranked Top-10 score range",
    "formula": "gap_i = (score_i - score_{i+1}) / max(score_1 - score_10, 1e-9)",
    "invariance": "unchanged under score' = a*score+b for any a>0",
    "zero_spread_rule": "if score_1 - score_10 <= 1e-9, return max_k",
    "evaluated_positions": [
      3,
      4,
      5,
      6,
      7,
      8,
      9
    ]
  },
  "candidate_policies": {
    "controls": [
      {
        "id": "FIXED-3",
        "k": 3
      },
      {
        "id": "FIXED-5",
        "k": 5
      },
      {
        "id": "FIXED-10",
        "k": 10
      }
    ],
    "adaptive": [
      {
        "id": "REL-GAP-005",
        "min_k": 3,
        "max_k": 10,
        "threshold": 0.05,
        "rule": "return the smallest i in evaluated_positions with gap_i >= threshold; otherwise max_k"
      },
      {
        "id": "REL-GAP-010",
        "min_k": 3,
        "max_k": 10,
        "threshold": 0.1,
        "rule": "return the smallest i in evaluated_positions with gap_i >= threshold; otherwise max_k"
      },
      {
        "id": "REL-GAP-020",
        "min_k": 3,
        "max_k": 10,
        "threshold": 0.2,
        "rule": "return the smallest i in evaluated_positions with gap_i >= threshold; otherwise max_k"
      },
      {
        "id": "MAX-GAP-010",
        "min_k": 3,
        "max_k": 10,
        "threshold": 0.1,
        "rule": "choose i with the largest gap_i, breaking ties toward smaller i, only if that maximum >= threshold; otherwise max_k"
      }
    ],
    "learned_policy_allowed": false
  },
