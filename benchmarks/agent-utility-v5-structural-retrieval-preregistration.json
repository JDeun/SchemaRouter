  "structural_features": {
    "tool_identifier_match": {
      "definition": "Add a bonus only when an ASCII query token matches the complete tool name/key leaf after conservative English singularization. Partial identifier components such as aux_job_076 do not count as exact tool identifiers.",
      "singularization": "ies->y; terminal s removed for words longer than 3 except ss; otherwise unchanged"
    },
    "operation_family_match": {
      "definition": "Add a bonus when a query token and endpoint-name/operation-alias token are exact or share a conservative ASCII alphabetic prefix family.",
      "minimum_token_length": 4,
      "minimum_common_prefix": 4,
      "minimum_prefix_fraction_of_shorter_token": 0.7
    },
    "schema_specificity_tiebreak": {
      "definition": "Tie-break equal final scores by descending mean catalog discrimination of schema terms; never added to score.",
      "terms": "tool name/description, endpoint name/description/operation aliases, field name/semantic_id/aliases/projection path",
      "discrimination": "log((N+1)/(df+1))/log(N+1)"
    }
  },
