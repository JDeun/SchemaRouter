    "SR-PROGRESSIVE-STATIC",
    "SR-5-STATE-AWARE",
    "FULL",
    "ORACLE"
  ],
  "condition_contracts": {
    "SR-5-STATIC": "initial Top-5 only; no retrieval refresh",
    "SR-PROGRESSIVE-STATIC": "frozen static widening of original-query candidates only",
    "SR-5-STATE-AWARE": "initial Top-5, then at most one fresh Top-5 retrieval after each completed/failed tool turn using only the allowed observable state contract",
    "FULL": "full registered capability catalog",
    "ORACLE": "gold required capabilities exposed for upper-bound diagnosis only"
  },
  "candidate_budget": {
