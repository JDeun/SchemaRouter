    "initial-miss recovery rate",
    "multi-step state completion",
    "total unique candidates exposed",
    "tool-schema tokens",
    "total input tokens",
    "retrieval calls",
    "model turns",
    "tool calls",
    "episode wall latency",
    "failed executions",
