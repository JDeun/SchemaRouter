      "oracle_task_graph",
      "hidden_expected_answer",
      "hidden_reference_fact",
      "condition_name",
      "SchemaRouter rank score",
      "SchemaRouter rank position"
    ],
    "free_text_tool_output_injected_into_retrieval": false,
    "execution_authority_unchanged": true
