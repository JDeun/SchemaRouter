  "current_research_conclusion": {
    "supported_selection_problem": "Accepted operation-fit selector materially reduces wrong-endpoint errors.",
    "unsupported_boundary_problem": "Near-domain unsupported rejection does not improve when selector quality improves.",
    "global_threshold_problem": "Candidate-fit similarity distributions overlap too strongly for one scalar threshold to satisfy both supported recall and unsupported rejection.",
    "next_candidate_direction": [
      "retain bounded accepted operation selector",
      "retain registered-schema execution authority",
      "use route/boundary-local thresholds where justified by fresh development only",
      "introduce explicit negative-capability and unknown evidence",
      "project incompatible evidence kinds independently",
      "rerank only within authorized candidate sets"
    ]
