  "template_semantics": {
    "capability_action": "Express the registered endpoint description as a user-facing capability request while retaining tool/resource and operation identity.",
    "output_need": "Express a need for declared output semantic IDs, field descriptions, datatypes, units and dimensions, without inventing undeclared outputs.",
    "input_to_output": "Express a request that supplies or refers to declared required inputs and asks for the registered endpoint outcome.",
    "policy_sensitive_action": "Encode read-only, write, and destructive distinctions using deterministic user-facing wording derived only from endpoint policy flags and endpoint identity."
  },
  "normalization": {
