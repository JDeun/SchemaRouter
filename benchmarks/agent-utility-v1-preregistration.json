    "ground_truth_trigger_forbidden": true
  },
  "governance": {
    "paired_tasks_across_conditions": true,
    "no_post_result_task_removal": true,
    "no_k_tuning_from_results": true,
    "no_prompt_tuning_from_test_rows": true,
    "no_retriever_weight_tuning_from_test_rows": true,
    "report_metrics_separately": true,
    "composite_score_forbidden": true
  },
